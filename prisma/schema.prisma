generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  githubUsername String?
  accounts Account[]
  sessions Session[]
  portfolio Portfolio?
  projects Project[]
  analysisRequests AnalysisRequest[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  refresh_token_expires_in Int?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
model Portfolio {
  id String @id @default(cuid())
  userId String @unique
  slug String @unique
  displayName String
  headline String @default("")
  biography String @default("")
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Project {
  id String @id @default(cuid())
  ownerId String
  githubRepositoryId String
  name String
  fullName String
  description String? @db.Text
  url String
  primaryLanguage String?
  languages Json
  stars Int @default(0)
  forks Int @default(0)
  readme String? @db.Text
  manifests Json
  contributionEvidence Json
  repositoryCreatedAt DateTime?
  repositoryUpdatedAt DateTime?
  importedAt DateTime @default(now())
  refreshedAt DateTime?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  analysis ProjectAnalysis?
  @@unique([ownerId, githubRepositoryId])
  @@index([ownerId, importedAt])
}
model ProjectAnalysis {
  id String @id @default(cuid())
  projectId String @unique
  title String
  summary String @db.Text
  purpose String @db.Text
  features Json
  technologies Json
  skills Json
  evidence Json
  source String
  generatedAt DateTime @default(now())
  approved Boolean @default(false)
  approvedTitle String?
  approvedSummary String? @db.Text
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
model AnalysisRequest {
  id String @id @default(cuid())
  ownerId String
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, createdAt])
}
